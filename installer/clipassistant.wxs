<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI for ClipAssistant (no UAC prompt).

  Build from the repository root, after `cargo build` with release profile:

    candle -arch x64 -dVersion=0.1.0 -dReleaseDir=%CD%\target\release -dRepoDir=%CD% ^
           -out target\wix\ installer\clipassistant.wxs
    light -out target\wix\clipassistant.msi target\wix\clipassistant.wixobj
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="剪贴助手"
      Language="2052"
      Codepage="936"
      Version="$(var.Version)"
      Manufacturer="ClipAssistant"
      UpgradeCode="A3E9F1C2-7B4D-4E8A-9C61-2F5D8B0473EE">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perUser"
        InstallPrivileges="limited"
        Description="剪贴助手 — 剪贴板历史工具"
        Comments="ClipAssistant, a local clipboard history manager for Windows." />

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的剪贴助手，请先卸载后再安装。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.RepoDir)\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="ClipAssistant" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppShortcutFolder" Name="剪贴助手" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*" Win64="yes">
        <File Id="ClipAssistantExe"
              Source="$(var.ReleaseDir)\clipassistant.exe"
              KeyPath="yes"
              Checksum="yes">
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="剪贴助手"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon"
                    Advertise="yes" />
        </File>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AppShortcutFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
        <Shortcut Id="StartMenuShortcut"
                  Name="剪贴助手"
                  Target="[INSTALLFOLDER]clipassistant.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\ClipAssistant"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="剪贴助手" Level="1" Display="expand" Absent="disallow">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
